# Local API Proxy -- example configuration.
#
# COMMIT THIS FILE. DO NOT COMMIT .env.
# .gitignore excludes .env and every variant of it; this example is the only
# one that belongs in the repository. Never paste a real key into this file.
#
#   cp .env.example .env
#   # then edit .env and replace the two REPLACE-ME values below
#
# Every variable here is REQUIRED and has no default anywhere in the code.
# Leaving one out, or leaving it empty, stops the proxy at startup with a
# message naming every missing variable at once. Values are trimmed, and an
# empty value counts as missing.
#
# Do not quote values. Docker Compose treats quotes in an env_file as part of
# the value, so PORT="18989" becomes the literal string with quotes and fails
# the integer check.


# ---------------------------------------------------------------------------
# Compose only -- not read by proxy.mjs
# ---------------------------------------------------------------------------

# Port on YOUR machine that the proxy is published on, bound to 127.0.0.1 only.
# Point Claude Code at this port. Change it if 18989 is already taken locally;
# it does not have to match PORT.
HOST_PORT=18989


# ---------------------------------------------------------------------------
# Network
# ---------------------------------------------------------------------------

# Bind address inside the container. Docker Compose OVERRIDES this to 0.0.0.0,
# because 127.0.0.1 in a container is the container's own loopback and would
# make the published port unreachable. It is kept here only for running
# `node proxy.mjs` directly outside Docker, where 127.0.0.1 is correct.
# Format: an IP or hostname, no spaces.
HOST=127.0.0.1

# Port the proxy listens on INSIDE the container.
# Format: integer 1-65535. Keep it at or above 1024 -- the container runs as a
# non-root user and cannot bind privileged ports.
PORT=18989


# ---------------------------------------------------------------------------
# Upstream gateway
# ---------------------------------------------------------------------------

# Base URL of the Anthropic-compatible gateway every request is forwarded to.
# Format: absolute URL, http:// or https:// only. A trailing path is allowed
# and is prefixed onto every route. Any other scheme is rejected.
UPSTREAM_BASE_URL=https://anyrouter.top

# Gateway credential, sent upstream as "Authorization: Bearer <key>".
# THIS IS A PLACEHOLDER AND WILL NOT WORK -- replace it with your own key.
# Format: printable ASCII, no whitespace.
# Treat the real value as a password: it bills to your account.
UPSTREAM_API_KEY=sk-REPLACE-WITH-YOUR-GATEWAY-KEY

# Shared secret Claude Code must present to THIS proxy. Every /v1/* request is
# rejected with 401 unless it matches. The port is bound to loopback only, so a
# short placeholder is fine for local use; use a long random value instead if
# you ever expose the port beyond this machine.
# Format: printable ASCII, no whitespace.
LOCAL_PROXY_KEY=sk-dummy


# ---------------------------------------------------------------------------
# Client identity
# ---------------------------------------------------------------------------

# Version in the synthesized User-Agent: claude-cli/<value> (external, sdk-cli)
# Used only when the calling client did not send its own User-Agent, which in
# practice means curl and nothing else -- Claude Code always sends its own.
# Format: non-empty printable ASCII, no newlines.
CLAUDE_CODE_VERSION=2.1.197

# Model used when a request body omits "model".
# Format: a model id string.
UPSTREAM_MODEL=claude-opus-4-8


# ---------------------------------------------------------------------------
# Limits and timeouts
# ---------------------------------------------------------------------------

# Socket timeout for each upstream request, in milliseconds. The server's own
# request timeout is this value plus 30000.
# Format: integer of at least 1. 300000 is 5 minutes.
UPSTREAM_TIMEOUT_MS=300000

# Retry-After header value on 429 and 5xx responses, when the gateway did not
# send its own. Format: integer of at least 1 (seconds).
# Do not set this to 1 -- clients will hammer a throttled upstream.
RETRY_AFTER_SECONDS=15

# Largest client request body accepted; anything bigger gets a 413.
# Format: integer of at least 1048576 (1 MiB). 26214400 is 25 MiB.
MAX_BODY_BYTES=26214400


# ---------------------------------------------------------------------------
# Responses bridge
# ---------------------------------------------------------------------------

# How many conversation contexts the /v1/responses bridge keeps in memory
# before evicting the oldest. Format: integer of at least 1.
# Setting this to 1 evicts on every store and breaks previous_response_id
# chaining with spurious 400s.
RESPONSES_STORE_MAX=128


# ---------------------------------------------------------------------------
# Console logging
#
# All three flags accept EXACTLY "true" or "false". Nothing else is accepted:
# not 1, not 0, not yes, not on, not empty. Anything else stops startup.
# ---------------------------------------------------------------------------

# Master switch for request logging to stdout. Under Docker this is everything
# `docker compose logs` can show you, so false makes the container silent.
PROXY_LOG=true

# Adds full client and upstream header dumps plus request bodies to the log.
# Leave false. When on, the upstream header dump includes the Authorization
# header, and inbound client headers are dumped in full. Debugging only.
PROXY_LOG_VERBOSE=false

# Characters of a body or message written to the console before truncation.
# Format: integer of at least 0. 0 truncates every logged body to nothing.
# (Note this is the OPPOSITE of what 0 means for PROXY_TRACE_BODY_LIMIT.)
PROXY_LOG_BODY_LIMIT=800


# ---------------------------------------------------------------------------
# File tracing  -- PRIVACY SENSITIVE, read this section
#
# The trace records full request bodies, full responses and raw SSE frames.
# That means your complete prompts and the model's complete replies, in
# plaintext, on disk. Redaction only masks the two keys above by exact match;
# it does nothing for prompt content, and it does not catch a credential that
# happens to appear inside a prompt or a reply.
#
# Shipped as false on purpose. Turn it on only while debugging.
# ---------------------------------------------------------------------------

# Where the trace is written. Under Docker this MUST be somewhere writable
# inside the container: the root filesystem is read-only and /tmp is the only
# writable path, mounted as a 64 MiB tmpfs that is discarded when the container
# stops. A path anywhere else silently produces no trace at all.
# Never point this inside the repository directory.
# Format: a writable file path.
PROXY_TRACE_FILE=/tmp/proxy-trace.log

# Master switch for the file trace. Exactly "true" or "false".
PROXY_TRACE=false

# Characters of each traced value before truncation.
# Format: integer of at least 0. 0 here means NO truncation -- entire bodies
# are written verbatim. This is the opposite of PROXY_LOG_BODY_LIMIT=0, which
# truncates to nothing. The two look alike and behave oppositely at 0.
PROXY_TRACE_BODY_LIMIT=4000
